# 本文件没有可用密码。全新部署先执行 scripts/bootstrap_demo.py --prepare-env，
# 再 docker compose up -d，最后执行 scripts/bootstrap_demo.py。
# 如果已有 .env，初始化脚本保留人工配置；数据库账号凭据仅见 .runtime/。
MYSQL_ROOT_PASSWORD=
APP_DATABASE_URL=mysql+pymysql://legal_app@127.0.0.1:3308/legal_app?charset=utf8mb4
ANALYTICS_DATABASE_URL=mysql+pymysql://legal_reader@127.0.0.1:3308/legal_analytics?charset=utf8mb4
# mock 为显式演示，http 为真实已部署模型服务。
MODEL_MODE=http
MODEL_BASE_URL=
MODEL_NAME=legal-sql-v1
MODEL_API_KEY=
# DeepSeek 可设置 MODEL_NAME=deepseek-flash、MODEL_BASE_URL=https://api.deepseek.com，
# 并开启以下两项；普通微调服务不支持时保持 false、删除 MODEL_THINKING。
MODEL_JSON_MODE=false
# MODEL_THINKING=disabled
MODEL_TIMEOUT_SECONDS=12
QUERY_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=30
MAX_ROWS=1000
MAX_RESULT_BYTES=1000000
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
